---
import '../styles/global.css';
import { CONTACT_EMAIL, DESCRIPTION, DOMAIN, PRICE_LABEL, REPLY_TIME, TITLE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = TITLE,
  description = DESCRIPTION,
  ogImage,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || String(Astro.site);
const offerSubject = encodeURIComponent(`Acquisition Inquiry - ${DOMAIN}`);
const navLinks = [
  { href: '#why', label: 'Why This Domain' },
  { href: '#seo', label: 'SEO & Market Fit' },
  { href: '#use-cases', label: 'Use Cases' },
  { href: '#faq', label: 'Buyer FAQ' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="J6nFpQgAidyR7S0a6k9NNgOgl5nmdwO4dJhkOl7VxQE" />

    <!-- Preconnect to CDN -->
    <link rel="preconnect" href="https://imagedelivery.net" />
    <link rel="dns-prefetch" href="https://imagedelivery.net" />

    <title>{title}</title>

    <!-- Self-hosted fonts (no third-party render-blocking requests) -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />

    <style is:inline>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: 0.75rem 1rem;
        background: #B85C38;
        color: #fff;
        font-weight: 600;
        border-radius: 0 0 0.75rem 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </head>
  <body class="bg-[#F8F1E9] text-[#2D2D2D] antialiased overflow-x-clip">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Navigation -->
    <nav class="bg-white/95 backdrop-blur-md border-b border-[#EDE4D7] sticky top-0 z-50" id="navbar" aria-label="Primary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-16 md:h-20 gap-3">
          <a href="/" class="flex items-center gap-x-2 sm:gap-x-3 min-w-0">
            <div class="w-8 h-8 sm:w-9 sm:h-9 bg-[#B85C38] rounded-xl flex items-center justify-center shrink-0">
              <span class="text-white text-lg sm:text-2xl font-bold tracking-tighter">WLT</span>
            </div>
            <div class="truncate">
              <span class="font-semibold text-lg sm:text-2xl tracking-tight">waxlashtan</span>
              <span class="font-semibold text-lg sm:text-2xl tracking-tight text-[#B85C38]">.com</span>
            </div>
          </a>

          <div class="flex items-center gap-x-2 sm:gap-x-4 shrink-0">
            {navLinks.map((link) => (
              <a
                href={link.href}
                class="hidden md:inline-flex items-center px-3 lg:px-4 py-2 md:min-h-11 text-sm font-medium text-[#4A5D4A] hover:text-[#2D2D2D] transition-colors"
              >
                {link.label}
              </a>
            ))}

            <a
              href="#acquire"
              class="inline-flex items-center justify-center min-h-11 px-4 sm:px-6 py-2 sm:py-2.5 bg-[#B85C38] hover:bg-[#A04E30] text-white text-xs sm:text-sm font-semibold rounded-2xl transition-all active:scale-[0.985] whitespace-nowrap"
            >
              Make an Offer
            </a>
          </div>
        </div>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-[#EDE4D7]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-10">
        <!-- Domain Acquisition CTA -->
        <div class="bg-gradient-to-r from-[#2D2D2D] via-[#3A3A3A] to-[#2D2D2D] rounded-2xl p-6 sm:p-8 md:p-10 mb-8 text-center border border-[#4A4A4A]">
          <div class="inline-block px-4 py-1 bg-white/10 rounded-full text-xs font-medium tracking-wider text-white/70 mb-4">
            PREMIUM DOMAIN AVAILABLE
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white mb-3">
            Acquire {DOMAIN}
          </h3>
          <p class="text-lg font-semibold text-[#E8A87C] mb-2">
            Asking price {PRICE_LABEL} USD &middot; escrow-protected transfer
          </p>
          <p class="text-white/60 max-w-lg mx-auto mb-6">
            A rare, service-exclusive premium domain with SEO built directly into the name.
            Own the definitive digital identity for the wax, lash, and tan market.
          </p>
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3">
            <a
              href={`mailto:${CONTACT_EMAIL}?subject=${offerSubject}`}
              class="inline-flex items-center justify-center gap-x-2 px-6 sm:px-8 py-3 bg-[#B85C38] hover:bg-[#A04E30] text-white font-semibold rounded-xl transition-all"
            >
              <span>Inquire: {CONTACT_EMAIL}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </a>
            <button
              type="button"
              data-copy-email
              class="inline-flex items-center justify-center gap-x-2 px-6 py-3 border border-white/20 hover:bg-white/5 text-white font-medium rounded-xl transition-all text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
              <span data-copy-label>Copy Email</span>
            </button>
          </div>
          <p class="mt-6 text-xs text-white/40">
            Serious inquiries only. Replies within {REPLY_TIME} &middot; Licensed escrow used for every transfer.
          </p>
        </div>

        <!-- Bottom: Disclaimer + Info -->
        <div class="border-t border-[#EDE4D7] pt-8">
          <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm mb-6">
            {navLinks.map((link) => (
              <a href={link.href} class="inline-flex items-center min-h-11 text-[#4A5D4A] hover:text-[#B85C38] transition-colors py-1">
                {link.label}
              </a>
            ))}
            <a href="#acquire" class="inline-flex items-center min-h-11 text-[#4A5D4A] hover:text-[#B85C38] transition-colors py-1">Make an Offer</a>
          </nav>

          <p class="text-xs text-[#6B6B6B] mb-6 leading-relaxed max-w-3xl mx-auto text-center">
            <strong>Disclaimer:</strong> {DOMAIN} is offered for sale as a domain name asset. Listing a domain for sale is not an
            offer of beauty, salon, waxing, lash or tanning services, nor a guarantee of search rankings or business outcomes.
            Any purchase is completed privately between the parties through a licensed third-party escrow provider.
            Pricing, availability and terms are subject to change without notice.
          </p>
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-y-2 text-xs text-[#6B6B6B]">
            <div>
              <p>&copy; {new Date().getFullYear()} {DOMAIN} &mdash; A premium domain available for acquisition.</p>
            </div>
            <div class="flex flex-wrap items-center gap-x-4">
              <span>Exact service match</span>
              <span class="hidden md:inline">&bull;</span>
              <span>{PRICE_LABEL} USD</span>
              <span class="hidden md:inline">&bull;</span>
              <span>Escrow-protected</span>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile sticky CTA -->
    <div
      class="fixed inset-x-0 bottom-0 z-50 md:hidden border-t border-[#EDE4D7] bg-white/95 backdrop-blur px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-4px_16px_rgba(0,0,0,0.06)]"
      role="region"
      aria-label="Quick inquiry"
    >
      <div class="flex items-center gap-4">
        <div class="min-w-0 flex-1">
          <p class="text-xs uppercase tracking-wider text-[#6B6B6B] leading-tight">Asking price</p>
          <p class="text-[#2D2D2D] font-bold text-lg leading-tight">{PRICE_LABEL} USD</p>
        </div>
        <a
          href="#acquire"
          class="shrink-0 inline-flex items-center justify-center min-h-12 rounded-2xl bg-[#B85C38] px-5 py-3 text-sm font-bold text-white shadow-lg shadow-[#B85C38]/30"
        >
          Make an Offer
        </a>
      </div>
    </div>

    <script>
      const CONTACT = 'sales@desertrich.com';

      document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const label = btn.querySelector<HTMLElement>('[data-copy-label]');
          try {
            await navigator.clipboard.writeText(CONTACT);
            if (label) {
              const original = label.textContent;
              label.textContent = 'Copied!';
              btn.classList.add('bg-green-600', 'border-green-500');
              setTimeout(() => {
                label.textContent = original;
                btn.classList.remove('bg-green-600', 'border-green-500');
              }, 2200);
            }
          } catch {
            window.location.href = 'mailto:' + CONTACT;
          }
        });
      });

      const nav = document.getElementById('navbar');
      const onScroll = () => {
        if (!nav) return;
        nav.classList.toggle('shadow-sm', window.scrollY > 20);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
