          <span class="text-sm text-white/60">or reasonable offer</span>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 lg:gap-10 items-start">
        <!-- Offer form -->
        <form id="offer-form" class="bg-white rounded-3xl p-5 sm:p-8 text-[#2D2D2D] border border-white/10" novalidate>
          <h3 class="text-xl sm:text-2xl font-bold mb-1">Make an offer</h3>
          <p class="text-sm text-[#6B6B6B] mb-5">
            Submit your offer and we&rsquo;ll reply within {REPLY_TIME}. Your email app opens with everything filled in — nothing is stored on this site.
          </p>

          <div class="space-y-4">
            <div>
              <label for="offer-name" class="block text-sm font-medium mb-1.5">Your name</label>
              <input
                id="offer-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                class="w-full min-h-12 rounded-xl border border-[#D4C9B8] bg-[#F8F1E9] px-4 py-3 text-base outline-none focus:border-[#B85C38] focus:ring-2 focus:ring-[#B85C38]/20"
                placeholder="Jane Doe"
              />
            </div>

            <div>
              <label for="offer-email" class="block text-sm font-medium mb-1.5">Email</label>
              <input
                id="offer-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                class="w-full min-h-12 rounded-xl border border-[#D4C9B8] bg-[#F8F1E9] px-4 py-3 text-base outline-none focus:border-[#B85C38] focus:ring-2 focus:ring-[#B85C38]/20"
                placeholder="you@company.com"
              />
            </div>

            <div>
              <label for="offer-amount" class="block text-sm font-medium mb-1.5">Your offer (USD)</label>
              <input
                id="offer-amount"
                name="amount"
                type="text"
                inputmode="numeric"
                class="w-full min-h-12 rounded-xl border border-[#D4C9B8] bg-[#F8F1E9] px-4 py-3 text-base outline-none focus:border-[#B85C38] focus:ring-2 focus:ring-[#B85C38]/20"
                placeholder="82,000"
              />
            </div>

            <div>
              <label for="offer-message" class="block text-sm font-medium mb-1.5">Message <span class="text-[#6B6B6B] font-normal">(optional)</span></label>
              <textarea
                id="offer-message"
                name="message"
                rows="3"
                class="w-full rounded-xl border border-[#D4C9B8] bg-[#F8F1E9] px-4 py-3 text-base outline-none focus:border-[#B85C38] focus:ring-2 focus:ring-[#B85C38]/20"
                placeholder="Timeline, escrow preference, questions…"
              ></textarea>
            </div>
          </div>

          <p id="offer-error" class="hidden mt-3 text-sm text-[#B3261E]" role="alert"></p>

          <button
            type="submit"
            class="mt-5 w-full min-h-12 inline-flex items-center justify-center gap-x-2 px-8 py-3.5 bg-[#B85C38] hover:bg-[#A04E30] text-white font-semibold rounded-2xl transition-all active:scale-[0.985]"
          >
            <span>Send My Offer</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </button>

          <p class="mt-4 text-xs text-[#6B6B6B] leading-relaxed">
            Escrow-protected &middot; no obligation &middot; your details are only used to reply to this inquiry.
          </p>
        </form>

        <!-- Direct contact -->
        <div class="space-y-5">
          <div class="bg-white/5 border border-white/15 rounded-3xl p-5 sm:p-7">
            <h3 class="text-lg sm:text-xl font-bold mb-3">Prefer to talk directly?</h3>
            <a
              href={`mailto:${CONTACT_EMAIL}?subject=${offerSubject}&body=Hello,%0D%0A%0D%0AI%20am%20interested%20in%20acquiring%20waxlashtan.com.%0D%0A%0D%0AName%3A%0D%0AOffer%3A%0D%0ATimeline%3A%0D%0A%0D%0ABest%20regards,"`}
              class="inline-flex items-center justify-center gap-x-3 w-full px-6 sm:px-8 py-3.5 sm:py-4 bg-white text-[#2D2D2D] hover:bg-[#F8F1E9] font-semibold text-base sm:text-lg rounded-3xl transition-all active:scale-[0.985] mb-3"
            >
              <span>{CONTACT_EMAIL}</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
            <button
              type="button"
              data-copy-email
              class="w-full inline-flex items-center justify-center gap-x-3 px-6 sm:px-8 py-3.5 sm:py-4 border border-white/30 hover:bg-white/5 font-medium text-base sm:text-lg rounded-3xl transition-all text-white"
            >
              <span data-copy-label>Copy Contact Email</span>
            </button>
          </div>

          <ul class="bg-white/5 border border-white/15 rounded-3xl p-5 sm:p-7 space-y-3 text-sm sm:text-base text-white/75">
            <li class="flex gap-x-3">
              <svg class="w-5 h-5 shrink-0 text-[#E8A87C]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Completed through licensed third-party escrow (Escrow.com or equivalent).</span>
            </li>
            <li class="flex gap-x-3">
              <svg class="w-5 h-5 shrink-0 text-[#E8A87C]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Clean, unencumbered .com with clear title — no UDRP or spam history.</span>
            </li>
            <li class="flex gap-x-3">
              <svg class="w-5 h-5 shrink-0 text-[#E8A87C]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Most transfers complete in 1–5 days once escrow is funded.</span>
            </li>
            <li class="flex gap-x-3">
              <svg class="w-5 h-5 shrink-0 text-[#E8A87C]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Staged payments available for qualified buyers.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FAQ />

  <script>
    const form = document.getElementById('offer-form') as HTMLFormElement | null;
    const error = document.getElementById('offer-error');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();

      const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      const amount = (form.elements.namedItem('amount') as HTMLInputElement).value.trim();
      const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();

      const showError = (text: string) => {
        if (!error) return;
        error.textContent = text;
        error.classList.remove('hidden');
      };

      if (!name || !email) {
        showError('Please add your name and email so we can reply.');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Please enter a valid email address.');
        return;
      }
      error?.classList.add('hidden');

      const subject = encodeURIComponent(
        `Offer for waxlashtan.com${amount ? ` - $${amount}` : ''} - ${name}`,
      );
      const body = encodeURIComponent(
        [
          `Name: ${name}`,
          `Email: ${email}`,
          `Offer (USD): ${amount || 'Not specified'}`,
          '',
          message || 'I am interested in acquiring waxlashtan.com.',
          '',
          'Sent from waxlashtan.com',
        ].join('\r\n'),
      );

      window.location.href = `mailto:sales@desertrich.com?subject=${subject}&body=${body}`;
    });
  </script>
</Layout>
