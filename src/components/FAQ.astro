---
import { CONTACT_EMAIL, DOMAIN, faqs } from '../data/site';
---

<section id="faq" class="bg-white border-y border-[#EDE4D7] scroll-mt-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16 md:py-20">
    <div class="text-center mb-10">
      <div class="modern-pill mb-3">BUYER QUESTIONS</div>
      <h2 class="section-title">Frequently asked questions</h2>
      <p class="mt-4 text-[#5C5C5C]">
        Everything buyers ask before making an offer on {DOMAIN}.
      </p>
    </div>

    <div class="space-y-3">
      {
        faqs.map((faq) => (
          <details class="group bg-[#F8F1E9] border border-[#EDE4D7] rounded-2xl px-5 sm:px-6 open:shadow-sm">
            <summary class="flex items-start justify-between gap-4 py-4 sm:py-5 cursor-pointer list-none text-base sm:text-lg font-semibold text-[#2D2D2D] min-h-12">
              <span>{faq.question}</span>
              <svg
                class="w-5 h-5 shrink-0 mt-1 text-[#B85C38] transition-transform group-open:rotate-45"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </summary>
            <p class="pb-5 -mt-1 text-sm sm:text-base text-[#5C5C5C] leading-relaxed">{faq.answer}</p>
          </details>
        ))
      }
    </div>

    <p class="mt-8 text-center text-sm text-[#5C5C5C]">
      Something not covered?{' '}
      <a
        href={`mailto:${CONTACT_EMAIL}?subject=Question%20-%20${DOMAIN}`}
        class="font-semibold text-[#B85C38] underline underline-offset-2 hover:text-[#A04E30]"
      >
        Ask directly
      </a>
    </p>
  </div>
</section>
